{
  "name": "nexora-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start:client": "npm --prefix client start",
    "start:server": "npm --prefix server run dev",
    "start:electron": "wait-on http://localhost:3000 && electron .",
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\" \"npm run start:electron\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.4.0",
    "wait-on": "^7.2.0"
  }
}
